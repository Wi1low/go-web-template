# Copy to .env (gitignored). Loaded before the YAML file; real environment
# variables always win over .env values.
APP_ENV=dev

# Secrets and machine-specific endpoints — inject, never commit.
APP_DATABASE_DSN="root:root@tcp(127.0.0.1:3306)/web_template?charset=utf8mb4&parseTime=True&loc=Local"
APP_REDIS_ADDR=127.0.0.1:6379
APP_REDIS_PASSWORD=
APP_JWT_SIGNING_KEY=change-me-in-production

# Any key works the same way: APP_<SECTION>_<KEY>, dots/dashes → underscores.
# APP_SERVER_ADDR=:9090
# APP_PROMETHEUS_ENABLED=false
